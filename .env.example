# Snowflake credentials — copy to .env and fill in. NEVER commit .env.
SNOWFLAKE_ACCOUNT=xxxxx-xxxxx          # vd: ab12345.ap-southeast-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=HOSPITAL_WH
SNOWFLAKE_DATABASE=HOSPITAL
SNOWFLAKE_RAW_SCHEMA=RAW
